{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gloss",
  "version": "1.0.1",
  "identifier": "sh.aay.gloss",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gloss",
        "width": 1100,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Inline clarifications for CLI-agent conversations",
    "longDescription": "Gloss is a desktop chat UI for the coding agents installed on your machine (Claude Code, Codex CLI, Gemini CLI, Pi, Cursor Agent). Highlight any part of an answer and ask about it; the reply appears inline under that sentence.",
    "copyright": "Copyright 2026 Aayush Chawla",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzMjQ3RkRCOTcyMjZDRUYKUldUdmJDS1gyMzhrQXk2a3h6UENad0RKeTBQRW1ZUTlqUStzMUE3UXRDQkk2SnVvSlM4ZG9RTUcK",
      "endpoints": [
        "https://github.com/aayushch/gloss/releases/latest/download/latest.json"
      ]
    }
  }
}
