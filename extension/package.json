{
  "name": "gloss-extension",
  "version": "2.0.6",
  "private": true,
  "description": "Browser extension for Gloss: ask about any text you highlight on the web.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs --target all",
    "watch": "node build.mjs --target all --watch",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "zip": "node scripts/zip.mjs",
    "lint:firefox": "web-ext lint -s dist/firefox"
  },
  "dependencies": {
    "approx-string-match": "^2.0.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
